# Copy to .env to override defaults. Every variable here is optional — the
# stack (Airflow + dbt + Streamlit on local DuckDB) runs with the defaults and
# needs no cloud services or secrets.
#
# Consumed by docker-compose.yaml:

# Host path used for the container volume mounts (dags, logs, dbt, data...).
AIRFLOW_PROJ_DIR=.

# UID that owns files inside the containers. On Linux set to your host UID
# (run: id -u) to avoid root-owned files in mounted volumes.
AIRFLOW_UID=50000

# Airflow web login (defaults: airflow / airflow).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Extra pip packages to install into the Airflow containers at startup.
_PIP_ADDITIONAL_REQUIREMENTS=
