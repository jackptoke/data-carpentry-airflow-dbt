FROM python:3.12-slim
LABEL authors="jacktoke"

WORKDIR /opt/airflow

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

COPY ./dashboard ./dashboard

RUN pip install -r dashboard/requirements.txt

# The DuckDB database is NOT baked into the image. It is the pipeline's output
# and is mounted at runtime (see the dc-streamlit volume in docker-compose.yaml),
# so the dashboard always reflects the latest dbt build.